<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{asset "built/index.css"}}" />
    <script src="{{asset "built/index.js"}}" defer></script>

    <title>{{meta_title}}</title>

    {{ghost_head}}
    {{!-- Outputs important meta data and settings, should always be in <head> --}}

</head>
<body class="{{body_class}}">
<div class="gh-viewport">

<header id="gh-head" class="gh-head">
    <a class="gh-head-logo" href="{{@site.url}}" aria-label="{{@site.title}}">
        <svg class="gh-head-title-svg" viewBox="0 0 1000 200" preserveAspectRatio="xMidYMid meet" role="img">
            <title>{{@site.title}}</title>
            <text x="500" y="160" text-anchor="middle" textLength="990" lengthAdjust="spacingAndGlyphs" class="gh-head-title-text">{{@site.title}}</text>
        </svg>
    </a>
    <nav class="gh-head-nav" aria-label="Primary">
        <div class="gh-head-nav-scroll">
            {{navigation}}
            {{#if @site.members_enabled}}
                {{^if @member}}
                <a class="gh-nav-item gh-nav-subscribe" href="{{@site.signup_url}}">Subscribe</a>
                {{else}}
                <a class="gh-nav-item gh-nav-subscribe" href="#/portal/account">Account</a>
                {{/if}}
            {{/if}}
        </div>
        <button class="gh-head-nav-arrow" type="button" aria-label="Scroll navigation right">&rarr;</button>
    </nav>
</header>

<main class="gh-main">

    {{{body}}}
    {{!-- All content gets inserted here, index.hbs, post.hbs, etc --}}

</main>

<footer class="gh-foot">
    <div class="gh-container">
        <div class="gh-foot-menu">
            {{navigation type="secondary"}}
        </div>
    </div>
</footer>

</div>

{{!-- <foot> --}}
{{ghost_foot}}
{{!-- Outputs important scripts - should always be included before closing body tag --}}

</body>
</html>
