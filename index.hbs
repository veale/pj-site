{{!< default}}
{{!--
    Home: the enter-card. The persistent pixel-zone background, rectangle,
    menu tab and scroll indicator all live in default.hbs and survive SPA
    navigation — only this body content gets swapped in/out.
--}}
<div class="pj-page-home">
    <div class="enter-card" data-enter-card>
        <div class="enter-card__menu" data-enter-menu></div>
        <div class="enter-card__photo" data-enter-photo></div>
        <canvas class="enter-card__pixel" data-enter-pixel hidden></canvas>
        <a class="enter-card__link" href="#" data-enter-link>enter</a>
    </div>
</div>

<script>
(function () {
  const card = document.querySelector('[data-enter-card]');
  if (!card || card.dataset.inited) return;
  card.dataset.inited = '1';

  const photoEl = card.querySelector('[data-enter-photo]');
  const linkEl = card.querySelector('[data-enter-link]');
  const pixelCanvas = card.querySelector('[data-enter-pixel]');
  const menuEl = card.querySelector('[data-enter-menu]');

  // Build nav menu from cloned site navigation
  const navSource = document.querySelector('.pj-nav-source');
  if (navSource) {
    navSource.querySelectorAll('a').forEach((a) => {
      const link = document.createElement('a');
      link.href = a.getAttribute('href') || '#';
      link.textContent = a.textContent.trim();
      link.className = 'enter-card__menu-item';
      menuEl.appendChild(link);
    });
  }

  // ---- Menu sizing (per-largest-item, with vertical scale-down) ----
  function fitMenu() {
    const items = Array.from(menuEl.querySelectorAll('.enter-card__menu-item'));
    if (!items.length) return;
    const cs = getComputedStyle(menuEl);
    const padTop = parseFloat(cs.paddingTop) || 0;
    const padBottom = parseFloat(cs.paddingBottom) || 0;
    const padLeft = parseFloat(cs.paddingLeft) || 0;
    const padRight = parseFloat(cs.paddingRight) || 0;
    const innerH = menuEl.clientHeight - padTop - padBottom;
    const innerW = menuEl.clientWidth - padLeft - padRight;
    if (innerH <= 0 || innerW <= 0) return;
    const wBuf = 4;
    const targetW = Math.max(1, innerW - wBuf);
    const probeSize = 100;
    let maxRatio = 0;
    for (const el of items) {
      el.style.fontSize = probeSize + 'px';
      const r = el.scrollWidth / probeSize;
      if (r > maxRatio) maxRatio = r;
    }
    if (maxRatio <= 0) return;
    let size = targetW / maxRatio;
    for (const el of items) el.style.fontSize = size + 'px';
    let total = 0;
    for (const el of items) total += el.offsetHeight;
    if (total > innerH) {
      size = size * (innerH / total);
      for (const el of items) el.style.fontSize = size + 'px';
    }
  }
  let _fitScheduled = false;
  function scheduleFit() {
    if (_fitScheduled) return;
    _fitScheduled = true;
    requestAnimationFrame(() => { _fitScheduled = false; fitMenu(); });
  }
  if (window.ResizeObserver) {
    const obs = new ResizeObserver(scheduleFit);
    obs.observe(menuEl);
    obs.observe(card);
  }
  let _resizeBurst;
  window.addEventListener('resize', () => {
    scheduleFit();
    clearTimeout(_resizeBurst);
    _resizeBurst = setTimeout(scheduleFit, 120);
  });

  // ---- Pixel-dissolve the orange overlay to reveal the menu ----
  function pixelateAndReveal(instant) {
    if (instant) {
      photoEl.style.display = 'none';
      linkEl.style.display = 'none';
      pixelCanvas.hidden = true;
      return;
    }
    card.classList.add('enter-card--transitioning');
    const rect = photoEl.getBoundingClientRect();
    const w = Math.max(1, Math.floor(rect.width));
    const h = Math.max(1, Math.floor(rect.height));
    pixelCanvas.style.width = w + 'px';
    pixelCanvas.style.height = h + 'px';
    pixelCanvas.width = w; pixelCanvas.height = h;
    pixelCanvas.hidden = false;
    const ctx = pixelCanvas.getContext('2d');
    ctx.fillStyle = '#FF6720';
    ctx.fillRect(0, 0, w, h);
    photoEl.style.display = 'none';
    const cellSize = Math.max(8, Math.round(Math.min(w, h) / 22));
    const cols = Math.ceil(w / cellSize);
    const rows = Math.ceil(h / cellSize);
    const cells = [];
    for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) cells.push([c, r]);
    for (let i = cells.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const tmp = cells[i]; cells[i] = cells[j]; cells[j] = tmp;
    }
    const totalFrames = 26;
    const perFrame = Math.ceil(cells.length / totalFrames);
    let idx = 0;
    function step() {
      for (let k = 0; k < perFrame && idx < cells.length; k++, idx++) {
        const [c, r] = cells[idx];
        ctx.clearRect(c * cellSize, r * cellSize, cellSize, cellSize);
      }
      if (idx < cells.length) requestAnimationFrame(step);
      else pixelCanvas.hidden = true;
    }
    requestAnimationFrame(step);
  }

  linkEl.addEventListener('click', (e) => {
    e.preventDefault();
    try { sessionStorage.setItem('pj-entered', '1'); } catch (_) {}
    pixelateAndReveal(false);
  });

  // Wait for the display font to be loaded before showing the card, so the
  // "enter" text never flashes in a fallback font and reflows.
  function showCard() {
    if (card.classList.contains('enter-card--ready')) return;
    fitMenu();
    card.classList.add('enter-card--ready');
    // If the user has already pressed enter in this session, skip the orange.
    let entered = false;
    try { entered = sessionStorage.getItem('pj-entered') === '1'; } catch (_) {}
    if (entered) pixelateAndReveal(true);
  }
  if (document.fonts && document.fonts.load) {
    Promise.all([
      document.fonts.load('400 64px "NaNHoloGigawide Ultra"'),
      document.fonts.load('900 64px "NaNHoloGigawide Ultra"')
    ]).catch(() => {}).then(() => {
      (document.fonts.ready || Promise.resolve()).then(showCard);
    });
  } else {
    showCard();
  }
  setTimeout(showCard, 2000);
})();
</script>
