{{!< default}}
{{!--
    Front page = hero gallery only. Posts live on /news/ via page-news.hbs.
    Editor adds a Ghost Page with slug "home-hero" containing a Gallery card
    or Image cards; this template pulls its rendered HTML.
--}}
<section class="hero-gallery" data-hero-gallery>
    <div class="hero-gallery__source" hidden>
        {{#get "pages" filter="slug:home-hero" as |heroPages|}}
            {{#foreach heroPages}}
                {{{content}}}
            {{/foreach}}
        {{/get}}
    </div>
    <div class="hero-gallery__stage" data-hero-stage></div>
    <div class="hero-gallery__hint" data-hero-hint>scroll &darr;</div>
</section>
