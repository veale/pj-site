{{!< default}}
{{!--
    Front page = hero gallery only. Posts live on /news/ via page-news.hbs.
    Editor adds a Ghost Page with slug "home-hero" containing a Gallery card
    or Image cards; this template pulls its rendered HTML.
--}}
<section class="hero-gallery" data-hero-gallery>
    <div class="hero-gallery__source" hidden>
        {{#get "pages" filter="slug:home-hero" as |heroPages|}}
            {{#foreach heroPages}}
                {{{content}}}
            {{/foreach}}
        {{/get}}
    </div>
    <div class="hero-gallery__stage" data-hero-stage></div>
</section>

<script type="module">
import { VFX } from "https://esm.sh/@vfx-js/core@0.8.0";

const postShader = `
precision highp float;
uniform sampler2D src;
uniform vec2 offset;
uniform vec2 resolution;
uniform float time;
out vec4 outColor;

vec4 readTex(vec2 uv) {
  vec4 c = texture(src, uv);
  c.a *= smoothstep(.5, .499, abs(uv.x - .5)) * smoothstep(.5, .499, abs(uv.y - .5));
  return c;
}

vec2 zoom(vec2 uv, float t) { return (uv - .5) * t + .5; }
float rand(vec3 p) { return fract(sin(dot(p, vec3(829., 4839., 432.))) * 39428.); }

void main() {
  vec2 uv = (gl_FragCoord.xy - offset) / resolution;

  vec2 p = uv * 2. - 1.;
  p.x *= resolution.x / resolution.y;
  float l = length(p);

  float dist = pow(l, 2.) * .3;
  dist = smoothstep(0., 1., dist);
  uv = zoom(uv, 0.5 + dist);

  float a = atan(p.y, p.x);
  float rd = rand(vec3(a, time, 0));
  uv = (uv - .5) * (1.0 + rd * pow(l * 0.7, 3.) * 0.3) + .5;

  vec2 uvr = uv, uvg = uv, uvb = uv;
  float d = (1. + sin(uv.y * 20. + time * 3.) * 0.1) * 0.05;
  uvr.x += 0.0015;
  uvb.x -= 0.0015;
  uvr = zoom(uvr, 1. + d * l * l);
  uvb = zoom(uvb, 1. - d * l * l);

  vec4 cr = readTex(uvr);
  vec4 cg = readTex(uvg);
  vec4 cb = readTex(uvb);
  outColor = vec4(cr.r, cg.g, cb.b, (cr.a + cg.a + cb.a));

  vec4 deco = vec4(0.);
  float res = resolution.y;
  deco += (sin(uv.y * res * .7 + time * 100.) * sin(uv.y * res * .3 - time * 130.)) * 0.05;
  deco += smoothstep(.01, .0, min(fract(uv.x * 20.), fract(uv.y * 20.))) * 0.1;
  outColor += deco * smoothstep(2., 0., l);

  outColor *= 1.8 - l * l;
  outColor += rand(vec3(p, time)) * 0.1;
}
`;

const itemShader = `
precision highp float;
uniform sampler2D src;
uniform vec2 offset;
uniform vec2 resolution;
uniform float time;
uniform float id;
out vec4 outColor;

vec4 readTex(vec2 uv) {
  vec4 c = texture(src, uv);
  c.a *= smoothstep(.5, .499, abs(uv.x - .5)) * smoothstep(.5, .499, abs(uv.y - .5));
  return c;
}

float rand(vec2 p) { return fract(sin(dot(p, vec2(829., 483.))) * 394.); }

void main() {
  vec2 uv = (gl_FragCoord.xy - offset) / resolution;
  vec2 uvr = uv, uvg = uv, uvb = uv;

  float r = rand(vec2(floor(time * 12.), id));
  if (r > 0.89) {
    float y = sin(floor(uv.y / 0.07)) + sin(floor(uv.y / 0.003 + time));
    float f = rand(vec2(y, floor(time * 5.0) + id)) * 2. - 1.;
    uvr.x += f * 0.1;
    uvg.x += f * 0.2;
    uvb.x += f * 0.3;
  }

  float r2 = rand(vec2(floor(time * 9.), id + 10.));
  if (r2 > 0.96) {
    uvr.x += sin(uv.y * 7. + time + id + 1.) * 0.03;
    uvg.x += sin(uv.y * 5. + time + id + 2.) * 0.03;
    uvb.x += sin(uv.y * 3. + time + id + 3.) * 0.03;
  }

  vec4 cr = readTex(uvr);
  vec4 cg = readTex(uvg);
  vec4 cb = readTex(uvb);
  outColor = vec4(cr.r, cg.g, cb.b, (cr.a + cg.a + cb.a));
}
`;

function attachVfx() {
    try {
        const vfx = new VFX({ scrollPadding: false });
        let i = 0;
        document.querySelectorAll('.hero-gallery__stage img').forEach((el) => {
            vfx.add(el, { shader: itemShader, uniforms: { id: i++ } });
        });
    } catch (err) {
        console.warn('VFX-JS init failed', err);
    }
}

if (document.documentElement.classList.contains('hero-gallery-ready')) {
    attachVfx();
} else {
    document.addEventListener('hero-gallery:ready', attachVfx, { once: true });
}
</script>
