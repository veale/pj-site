{{!< default}}
{{!--
    Front page: pixel-zone scrolling-text background + centered portrait card
    showing the first home-hero image. The card has an ENTER link; clicking
    it pixelates the photo and reveals a white panel filled with the nav menu
    items, stacked vertically.

    Settings for the pixel-zone background are tuned to match the agreed
    screenshot defaults.
--}}

{{!-- Hidden source: first image of the home-hero gallery --}}
<div class="index-hero-source" hidden>
    {{#get "pages" filter="slug:home-hero" as |heroPages|}}
        {{#foreach heroPages}}
            {{{content}}}
        {{/foreach}}
    {{/get}}
</div>

{{!-- Hidden source: site navigation cloned for the reveal panel --}}
<div class="index-nav-source" hidden>
    {{navigation}}
</div>

<section class="index-front" data-index-front data-site-title="{{@site.title}}">
    <div class="pixel-zone" id="pixel-zone" aria-hidden="true"></div>

    <div class="enter-card" data-enter-card>
        <div class="enter-card__photo" data-enter-photo></div>
        <canvas class="enter-card__pixel" data-enter-pixel hidden></canvas>
        <a class="enter-card__link" href="#" data-enter-link>enter</a>
        <div class="enter-card__menu" data-enter-menu hidden></div>
    </div>
</section>

<script>
(function () {
  // ---------------- Pixel-zone background ----------------
  const TEXT = (document.querySelector('[data-index-front]')?.dataset.siteTitle || 'possiblyjamie').trim() || 'possiblyjamie';
  const DPR = Math.max(1, window.devicePixelRatio || 1);

  const PALETTE_DARK = [
    '#FF1F4F', '#3CC8FF', '#A4FF1F', '#FFE000',
    '#FF6A1F', '#FF3838', '#1FFFE0', '#B41FFF',
    '#FF1FCC', '#1FFF6A', '#FFB81F', '#54FFFF'
  ];

  // Defaults pulled from the agreed screenshot.
  const state = {
    speed: 64,
    rowHeightVh: 10,
    rowNoise: 40 / 100,
    zoneWidth: 1140,
    maxPix: 1,
    fontScale: 101 / 100,
    colorCount: 1,
    outlineProp: 69,
    outlineThick: 3,
    overlap: false,
    bgColor: '#0a0a0a'
  };

  function hash(n) {
    n = n | 0;
    n = ((n ^ 61) ^ (n >>> 16)) | 0;
    n = (n + (n << 3)) | 0;
    n = (n ^ (n >>> 4)) | 0;
    n = Math.imul(n, 0x27d4eb2d) | 0;
    n = n ^ (n >>> 15);
    return n >>> 0;
  }
  function rowNoiseValue(idx) {
    return (hash(idx * 1234567 + 89) / 4294967295) * 2 - 1;
  }
  function rowHeightFor(idx, baseH, noiseAmount) {
    return baseH * (1 + rowNoiseValue(idx) * noiseAmount);
  }

  const stage = document.getElementById('pixel-zone');
  const off = document.createElement('canvas');
  const offCtx = off.getContext('2d');

  class Row {
    constructor(direction, idx) {
      this.direction = direction;
      this.idx = idx;
      this.position = (Math.random() - 0.5) * 4000;
      this.canvas = document.createElement('canvas');
      this.canvas.className = 'pixel-zone__row';
      this.ctx = this.canvas.getContext('2d');
      stage.appendChild(this.canvas);
      this._fontKey = '';
      this._letterWidths = [];
      this._wordWidth = 0;
      this.rowHeight = 0;
      this.rowHCanvas = 0;
      this.canvasHCanvas = 0;
      this.rowYCenter = 0;
    }
    layout(rowTop, rowHeight, viewportWidth) {
      const canvasHCSS = rowHeight;
      this.canvas.style.top = rowTop + 'px';
      this.canvas.style.height = canvasHCSS + 'px';
      this.canvas.style.width = viewportWidth + 'px';
      this.canvas.width = Math.max(1, Math.floor(viewportWidth * DPR));
      this.canvas.height = Math.max(1, Math.floor(canvasHCSS * DPR));
      this.rowHeight = rowHeight;
      this.rowHCanvas = rowHeight * DPR;
      this.canvasHCanvas = canvasHCSS * DPR;
      this.rowYCenter = this.canvasHCanvas / 2;
      this._fontKey = '';
    }
    measureLetters(fontStr) {
      if (this._fontKey === fontStr) return;
      this._fontKey = fontStr;
      this.ctx.font = fontStr;
      this._letterWidths = [];
      let total = 0;
      for (const ch of TEXT) {
        const w = this.ctx.measureText(ch).width;
        this._letterWidths.push(w);
        total += w;
      }
      this._wordWidth = total;
    }
    getColor(instanceIdx) {
      if (state.colorCount <= 1) return '#FFFFFF';
      const n = Math.min(state.colorCount, PALETTE_DARK.length);
      return PALETTE_DARK[hash(instanceIdx + this.idx * 1009) % n];
    }
    isOutline(instanceIdx) {
      if (state.outlineProp <= 0) return false;
      if (state.outlineProp >= 100) return true;
      const r = hash(instanceIdx * 7919 + this.idx * 5483 + 314159) % 1000;
      return r < state.outlineProp * 10;
    }
    update(dt) {
      this.position += this.direction * state.speed * DPR * dt;
    }
    draw() {
      const ctx = this.ctx;
      const w = this.canvas.width;
      const h = this.canvas.height;
      ctx.clearRect(0, 0, w, h);

      const fontSize = this.rowHCanvas * state.fontScale;
      const fontFam = '"NaNHoloGigawide Ultra", "NaNHoloGigawide", "Futura", "Helvetica Neue", "Arial Black", sans-serif';
      const fontStr = '900 ' + fontSize + 'px ' + fontFam;

      this.measureLetters(fontStr);
      const wordWidth = this._wordWidth;
      if (wordWidth <= 0) return;

      const startX = this.position;
      const firstInst = Math.floor((-startX) / wordWidth) - 1;
      const lastInst = Math.ceil((w - startX) / wordWidth) + 1;

      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.lineJoin = 'round';

      const yCenter = this.rowYCenter;
      const canvasThickness = state.outlineThick * DPR;

      for (let i = firstInst; i <= lastInst; i++) {
        const instX = startX + i * wordWidth;
        const color = this.getColor(i);
        const outline = this.isOutline(i);

        let cx = instX;
        for (let j = 0; j < TEXT.length; j++) {
          const ch = TEXT[j];
          const chW = this._letterWidths[j];
          if (cx + chW < 0 || cx > w) { cx += chW; continue; }
          ctx.font = fontStr;
          ctx.imageSmoothingEnabled = true;
          if (outline) {
            ctx.strokeStyle = color;
            ctx.lineWidth = canvasThickness;
            ctx.strokeText(ch, cx, yCenter);
          } else {
            ctx.fillStyle = color;
            ctx.fillText(ch, cx, yCenter);
          }
          cx += chW;
        }
      }
    }
  }

  const rows = [];

  function layoutRows() {
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const baseH = vh * (state.rowHeightVh / 100);
    const heights = [];
    let cumH = 0, i = 0;
    while (cumH < vh + baseH) {
      const h = rowHeightFor(i, baseH, state.rowNoise);
      heights.push(h);
      cumH += h;
      i++;
      if (i > 80) break;
    }
    const target = heights.length;
    while (rows.length < target) {
      const dir = rows.length % 2 === 0 ? -1 : 1;
      rows.push(new Row(dir, rows.length));
    }
    while (rows.length > target) {
      const r = rows.pop();
      stage.removeChild(r.canvas);
    }
    let cumTop = 0;
    rows.forEach((row, idx) => {
      row.layout(cumTop, heights[idx], vw);
      cumTop += heights[idx];
    });
  }

  let lastT = 0;
  function frame(t) {
    if (!lastT) lastT = t;
    const dt = Math.min(0.05, (t - lastT) / 1000);
    lastT = t;
    for (const row of rows) { row.update(dt); row.draw(); }
    requestAnimationFrame(frame);
  }

  document.body.style.backgroundColor = state.bgColor;
  window.addEventListener('resize', layoutRows);

  function startBg() {
    layoutRows();
    requestAnimationFrame(frame);
  }
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(startBg);
  } else {
    startBg();
  }

  // ---------------- Enter card ----------------
  const card = document.querySelector('[data-enter-card]');
  const photoEl = document.querySelector('[data-enter-photo]');
  const linkEl = document.querySelector('[data-enter-link]');
  const pixelCanvas = document.querySelector('[data-enter-pixel]');
  const menuEl = document.querySelector('[data-enter-menu]');

  // First image of home-hero
  const srcImg = document.querySelector('.index-hero-source img');
  let imgUrl = null;
  if (srcImg) {
    imgUrl = srcImg.getAttribute('src');
    photoEl.style.backgroundImage = 'url(' + imgUrl + ')';
  } else {
    photoEl.classList.add('enter-card__photo--empty');
  }

  // Build nav menu from cloned site navigation
  const navSource = document.querySelector('.index-nav-source');
  if (navSource) {
    const items = navSource.querySelectorAll('a');
    items.forEach((a) => {
      const link = document.createElement('a');
      link.href = a.getAttribute('href') || '#';
      link.textContent = a.textContent.trim();
      link.className = 'enter-card__menu-item';
      menuEl.appendChild(link);
    });
  }

  // Pixelate transition: render image at progressively smaller resolutions,
  // scale back up with nearest-neighbour, then crossfade into menu panel.
  function pixelateAndReveal() {
    if (!card.classList.contains('enter-card--ready')) return;
    card.classList.add('enter-card--transitioning');

    const rect = photoEl.getBoundingClientRect();
    const w = Math.max(1, Math.floor(rect.width));
    const h = Math.max(1, Math.floor(rect.height));
    pixelCanvas.style.width = w + 'px';
    pixelCanvas.style.height = h + 'px';
    pixelCanvas.width = w;
    pixelCanvas.height = h;
    pixelCanvas.hidden = false;

    const ctx = pixelCanvas.getContext('2d');
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => {
      photoEl.style.visibility = 'hidden';
      linkEl.style.visibility = 'hidden';

      const aspect = img.width / img.height;
      const boxAspect = w / h;
      let sx, sy, sw, sh;
      if (aspect > boxAspect) {
        sh = img.height;
        sw = img.height * boxAspect;
        sx = (img.width - sw) / 2;
        sy = 0;
      } else {
        sw = img.width;
        sh = img.width / boxAspect;
        sx = 0;
        sy = (img.height - sh) / 2;
      }

      const steps = [1, 2, 4, 8, 16, 28, 48, 80];
      let i = 0;
      function step() {
        const px = steps[i];
        const tw = Math.max(1, Math.floor(w / px));
        const th = Math.max(1, Math.floor(h / px));
        const tmp = document.createElement('canvas');
        tmp.width = tw; tmp.height = th;
        const tctx = tmp.getContext('2d');
        tctx.imageSmoothingEnabled = false;
        tctx.drawImage(img, sx, sy, sw, sh, 0, 0, tw, th);
        ctx.imageSmoothingEnabled = false;
        ctx.clearRect(0, 0, w, h);
        ctx.drawImage(tmp, 0, 0, tw, th, 0, 0, w, h);
        i++;
        if (i < steps.length) {
          setTimeout(step, 70);
        } else {
          // Reveal menu panel
          menuEl.hidden = false;
          requestAnimationFrame(() => {
            card.classList.add('enter-card--revealed');
          });
        }
      }
      step();
    };
    img.onerror = () => {
      photoEl.style.visibility = 'hidden';
      linkEl.style.visibility = 'hidden';
      menuEl.hidden = false;
      requestAnimationFrame(() => card.classList.add('enter-card--revealed'));
    };
    if (imgUrl) {
      img.src = imgUrl;
    } else {
      img.onerror();
    }
  }

  if (imgUrl) card.classList.add('enter-card--ready');
  else card.classList.add('enter-card--ready', 'enter-card--no-photo');

  linkEl.addEventListener('click', (e) => {
    e.preventDefault();
    pixelateAndReveal();
  });

  // Size menu items so they fill the rectangle vertically and fit horizontally
  function fitMenu() {
    if (menuEl.hidden) return;
    const items = menuEl.querySelectorAll('.enter-card__menu-item');
    if (!items.length) return;
    const cs = getComputedStyle(menuEl);
    const padTop = parseFloat(cs.paddingTop) || 0;
    const padBottom = parseFloat(cs.paddingBottom) || 0;
    const padLeft = parseFloat(cs.paddingLeft) || 0;
    const padRight = parseFloat(cs.paddingRight) || 0;
    const innerH = menuEl.clientHeight - padTop - padBottom;
    const innerW = menuEl.clientWidth - padLeft - padRight;
    // Start from per-item height, then shrink to fit horizontally
    let size = Math.floor(innerH / items.length);
    items.forEach((el) => {
      el.style.fontSize = size + 'px';
      el.style.lineHeight = '1';
    });
    // Shrink if any item overflows horizontally
    let safety = 60;
    while (safety-- > 0) {
      let overflow = false;
      items.forEach((el) => {
        if (el.scrollWidth > innerW + 1) overflow = true;
      });
      if (!overflow) break;
      size = Math.max(6, Math.floor(size * 0.94));
      items.forEach((el) => { el.style.fontSize = size + 'px'; });
    }
  }
  const fitObserver = new ResizeObserver(fitMenu);
  fitObserver.observe(menuEl);
  window.addEventListener('resize', fitMenu);
})();
</script>

<style>
/* Lock the page: no scrolling on the index */
html, body.home-template {
    height: 100%;
    overflow: hidden;
}
/* Hide the global header on the home page only */
body.home-template #gh-head,
body.home-template .gh-foot {
    display: none !important;
}
body.home-template .gh-viewport,
body.home-template .gh-main {
    height: 100vh;
    min-height: 100vh;
}

/* Background pixel zone */
.index-front {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.pixel-zone {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: #0a0a0a;
}
.pixel-zone__row {
    position: absolute;
    left: 0;
    display: block;
}

/* Hide the global title-mask layers on the front page — they reference the
 * old hero-gallery layout which isn't rendered here. */
body.home-template .title-mask-layer,
body.home-template .title-outline-layer {
    display: none !important;
}

/* Center card */
.enter-card {
    position: relative;
    z-index: 2;
    width: min(40vw, 50vh);
    aspect-ratio: 3 / 4;
    max-width: 420px;
    max-height: 80vh;
    margin: 6vmin auto;
    display: flex;
    align-items: center;
    justify-content: center;
}
@media (max-width: 700px) {
    .enter-card { width: min(70vw, 60vh); max-width: 360px; }
}
.enter-card__photo {
    position: absolute;
    inset: 0;
    background-color: #222;
    background-size: cover;
    background-position: center;
}
.enter-card__pixel {
    position: absolute;
    inset: 0;
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
}
.enter-card__link {
    position: relative;
    z-index: 3;
    font-family: "NaNHoloGigawide Ultra", var(--font-sans-serif);
    font-weight: 900;
    color: #fff;
    text-decoration: none;
    text-transform: lowercase;
    font-size: clamp(2.2rem, 6vmin, 5.2rem);
    letter-spacing: 0.02em;
    padding: 0.3em 0.6em;
    -webkit-text-stroke: 2px #fff;
    transition: color 160ms ease, opacity 200ms ease;
}
.enter-card__link:hover { color: transparent; }
.enter-card--transitioning .enter-card__link { opacity: 0; pointer-events: none; }

/* Menu reveal */
.enter-card__menu {
    position: absolute;
    inset: 0;
    background: #fff;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    opacity: 0;
    transition: opacity 260ms ease;
    padding: 4% 6%;
    gap: 0;
}
.enter-card--revealed .enter-card__menu { opacity: 1; }
.enter-card--revealed .enter-card__pixel { opacity: 0; transition: opacity 260ms ease; }
.enter-card__menu-item {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    font-family: "NaNHoloGigawide Ultra", var(--font-sans-serif);
    font-weight: 900;
    text-decoration: none;
    text-transform: lowercase;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px #000;
    transition: color 140ms ease, -webkit-text-stroke-width 140ms ease;
    white-space: nowrap;
}
.enter-card__menu-item:hover {
    color: #000;
    -webkit-text-stroke-width: 0;
}

/* Don't let the default theme's flex column rules squash us */
.gh-main { position: relative; z-index: 1; }
</style>
