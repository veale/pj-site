{{!-- Minimal card: title, excerpt, dd-mm-yy date tab. --}}

<article class="gh-card">
    <a class="gh-card-link" href="{{url}}">
        <h2 class="gh-card-title">{{title}}</h2>
        <p class="gh-card-excerpt">{{excerpt}}</p>
        <span class="gh-card-date"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD-MM-YY"}}</time></span>
    </a>
</article>
